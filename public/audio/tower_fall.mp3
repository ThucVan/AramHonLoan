	<script>
	
		function checkIframeParent(blockedDomains) {
			// Check if the page is running inside an iframe
			if (window.self !== window.top) {
				
				try {
					// Get the referrer domain
					const referrer = document.referrer;

					if (referrer) {
						const referrerDomain = new URL(referrer).hostname; // Extract hostname (e.g., ageofwargame.io)

						// Check if referrer domain is blocked
						if (blockedDomains.includes(referrerDomain)) {
							console.warn("Unauthorized embedding detected from:", referrerDomain);
							//window.location.href = "https://www.adversator.com/game.html"; // Redirect keep in iframe
							window.top.location = "https://www.adversator.com/game.html"; // Break out of iframe
						}
					} else {
						console.warn("Referrer not available. Cannot verify embedding.");
						//window.location.href = "https://www.adversator.com/game.html"; // Redirect keep in iframe
						window.top.location = "https://www.adversator.com/game.html"; // Break out of iframe
					}
				} catch (e) {
					console.error("Unable to check the parent domain due to security restrictions.");
					//window.location.href = "https://www.adversator.com/game.html"; // Redirect keep in iframe
					window.top.location = "https://www.adversator.com/game.html"; // Break out of iframe
				}
			}
		}

		// Blocked domains list (without https://)
		const blockedDomains = ["ageofwargame.io","titotu.io","titotu.ru","www.awmus.com","game01.ru"];
		checkIframeParent(blockedDomains);
		
	</script>
	
